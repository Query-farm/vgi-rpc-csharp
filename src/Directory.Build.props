<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NoWarn CS1591 (missing XML doc) until the public API surface stabilizes -->
    <!-- NU5104 is intentional while the public Arrow surface uses QueryFarm.Arrow's
         upstream-versioned, collision-proof `-queryfarm` fork. The fork README documents
         the temporary dependency and removal condition; pretending it is an upstream stable
         Arrow release would be materially more misleading than the prerelease suffix. -->
    <NoWarn>$(NoWarn);CS1591;NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$([MSBuild]::GetPathOfFileAbove('README.md', '$(MSBuildThisFileDirectory)../'))"
          Pack="true"
          PackagePath=""
          Visible="false" />
  </ItemGroup>

</Project>
