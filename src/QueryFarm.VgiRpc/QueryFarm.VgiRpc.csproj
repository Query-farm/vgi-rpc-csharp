<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Transport-agnostic RPC framework for .NET using Apache Arrow IPC, with reflection-based service contracts, streaming, and pipe, stdio, Unix socket, TCP, and shared-memory transports.</Description>
    <RootNamespace>QueryFarm.VgiRpc</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendored + patched Apache.Arrow (adds per-batch custom_metadata support, not yet
         in an official release — see third_party/apache-arrow-dotnet/README.md). -->
    <ProjectReference Include="..\..\third_party\apache-arrow-dotnet\src\Apache.Arrow\Apache.Arrow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Externalized objects may be stored zstd/gzip-compressed (WIRE_PROTOCOL.md §12). That is
         a storage-object encoding, not an HTTP transport concern, so the codec belongs wherever
         External/ does, and External/ is here because every transport carries pointer batches,
         not just HTTP. -->
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- QueryFarm.VgiRpc.Http dispatches HTTP requests outside RpcServer.ServeAsync's own loop
         (a request/response body has no persistent connection to drive a serve loop over — see
         docs/roadmap.md M6) and needs a few implementation-detail accessors
         (RpcServer.Implementation/ServerId/AccessLog) that aren't part of the public API. -->
    <InternalsVisibleTo Include="QueryFarm.VgiRpc.Http" />
  </ItemGroup>

</Project>
