<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Core wire protocol, reflection-based RPC engine, and pipe/stdio/Unix/TCP/SHM transports for vgi-rpc.</Description>
    <RootNamespace>QueryFarm.VgiRpc</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendored + patched Apache.Arrow (adds per-batch custom_metadata support, not yet
         in an official release — see third_party/apache-arrow-dotnet/README.md). -->
    <ProjectReference Include="..\..\third_party\apache-arrow-dotnet\src\Apache.Arrow\Apache.Arrow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
