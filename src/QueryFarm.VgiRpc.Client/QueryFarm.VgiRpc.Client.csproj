<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Async schema-first and typed clients for vgi-rpc over subprocess, Unix, TCP, named-pipe, and shared-memory transports.</Description>
    <RootNamespace>QueryFarm.VgiRpc.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <ProjectReference Include="..\QueryFarm.VgiRpc\QueryFarm.VgiRpc.csproj" />
    <!-- The HTTP client implements the internal reflection hooks (RpcReflection). -->
    <InternalsVisibleTo Include="QueryFarm.VgiRpc.Client.Http" />
  </ItemGroup>

  <!-- Pack RID-specific C ABI libraries when a release assembly stages them here. -->
  <ItemGroup Condition="Exists('runtimes')">
    <None Include="runtimes/**/native/*" Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
